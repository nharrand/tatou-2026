# Public template: copy this file to .env and replace every placeholder.
# Never commit .env, keys, passphrases, tokens, watermark keys, or course flags.
MARIADB_ROOT_PASSWORD=REPLACE_THIS_STRING_WITH_ROOT_PASSWORD
MARIADB_USER=tatou
MARIADB_PASSWORD=REPLACE_THIS_STRING_WITH_PASSWORD
FLAG_1=REPLACE_THIS_STRING_WITH_SERVER_FLAG
FLAG_2=REPLACE_THIS_STRING_WITH_SERVER_FLAG
# Generate a private value with: python -c "import secrets; print(secrets.token_hex(32))"
# Put the generated value in .env only; keep this template empty.
SECRET_KEY=
# Maximum accepted PDF size in bytes (64 MiB by default).
MAX_UPLOAD_SIZE_BYTES=67108864
# Set private Grafana administrator credentials.
GF_USERNAME=REPLACE_THIS_STRING_WITH_GRAFANA_USERNAME
GF_PASSWORD=REPLACE_THIS_STRING_WITH_GRAFANA_PASSWORD

# Configure optional Telegram notifications.
# Obtain a bot token from @BotFather and the target chat or channel ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional RMAP authentication. Leave every RMAP value empty to disable it.
# When enabling RMAP, set every required value together. `RMAP_KEYS_HOST_DIR`
# is mounted read-only at /app/rmap-keys; keep it outside the repository in
# production (for example, /home/softsec/secrets). To keep key material out of
# a disabled container, point it to an empty private directory instead.
RMAP_KEYS_HOST_DIR=
RMAP_SERVER_PUBLIC_KEY_PATH=
RMAP_SERVER_PRIVATE_KEY_PATH=
RMAP_CLIENT_KEYS_DIR=
RMAP_SERVER_KEY_PASSPHRASE=
# Preferred for protected private keys: an owner-only (mode 600) file mounted
# under /app/rmap-keys. Do not set both passphrase variables.
RMAP_SERVER_KEY_PASSPHRASE_FILE=
RMAP_DOCUMENT_ID=
RMAP_WATERMARK_METHOD=
RMAP_WATERMARK_KEY=
RMAP_WATERMARK_POSITION=
